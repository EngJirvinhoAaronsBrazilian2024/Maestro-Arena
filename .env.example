# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# Vercel provides this automatically (e.g. VERCEL_URL), but you can set it if needed.
APP_URL=""

# SPORTS_API_KEY: External sports provider API key (e.g. API-Sports).
# If omitted, the application will gracefully fall back to mock data.
SPORTS_API_KEY=""
SPORTS_API_URL="https://v3.football.api-sports.io"

# INSFORGE - Database & Auth
VITE_INSFORGE_URL="https://gci83gu5.us-east.insforge.app"
VITE_INSFORGE_ANON_KEY="your-anon-key-here"
INSFORGE_API_KEY="your-service-role-key-here"
